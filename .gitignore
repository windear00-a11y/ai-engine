# --- Python bytecode / caches ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg

# --- Virtual environments ---
.venv/
venv/
env/
ENV/

# --- Secrets / credentials / local env (never commit) ---
.env
.env.*
*.env
*.key
*.pem
id_rsa*
*.token
*.secret
credentials.*

# --- Editor / OS noise ---
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# --- Internal development automation / workflow state (not public) ---
.opencode/
.workflow/

# --- Temporary / generated files ---
*.log
tmp/
*.tmp
.cache/

# --- Downloaded raw corpora (regenerable, not part of the codebase) ---
sources/

# --- Knowledge Compiler generated output ---
output/

# --- Databases ---
# SQLite files are generated state and are never committed.
*.db
# Internal development knowledge database is repository-excluded (Gate 10-A).
database/*.db
database/knowledge.db.backup
